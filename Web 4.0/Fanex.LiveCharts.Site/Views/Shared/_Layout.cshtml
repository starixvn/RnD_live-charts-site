@using Fanex.LiveCharts.Core
<!DOCTYPE html>
<!--[if (IE 7)]><html lang="en" class="ie7 oldie"><![endif]-->
<!--[if (IE 8)]><html lang="en" class="ie8 oldie"><![endif]-->
<!--[if (IE 9)]><html lang="en" class="ie9"><![endif]-->
<!--[if (gt IE 9)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title </title>
    @*<link rel="shortcut icon" href="~/favicon.ico" />*@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--[if lt IE 9]><script src="~/scripts/_libs/utils/html5shiv.min.js" type="text/javascript"></script><![endif]-->
    @RenderSection("Head", false)

    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles")
    }
    else
    {
        <link href="~/Content/Bootstrap/bootstrap.less" rel="stylesheet" type="text/css" />
    }
    <script type="text/javascript">
        (function (i, s, o, g, r, a, m) {
            i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () {
                (i[r].q = i[r].q || []).push(arguments)
            }, i[r].l = 1 * new Date(); a = s.createElement(o),
        m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
        })(window, document, 'script', '//www.google-analytics.com/analytics.js', 'ga');

        ga('create', 'UA-46051934-1', 'starific.net');
        ga('send', 'pageview');
    </script>
</head>
<body>
        @RenderBody()
    
    @Html.Hidden("LiveChartRoot", Url.Content("~/"))
    
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jquerylibs")
    
    <script type="text/javascript">
        var DEFAULT_OBJECT = {
            datePickerImage: '@(Url.Content("~/Content/Images/calendar.gif"))',
            lblOddsValue: '@(Lang.OddsValue)',
            lblBetcountValue: '@(Lang.BetCountVolumn)',
            lblOpenTime: '@(Lang.OpenTime)',
            lblHdpHome: '@(Lang.HdpHome)',
            lblOddsDEC: '@(Lang.OddsDEC)',
            lblPriceMovement: '@(Lang.PriceMovement)',
            lblMarketMovement: '@(Lang.MarketMovement)',
            lblTime: '@(Lang.Time)',
            lblNumOfTicket: '@(Lang.BetCountVolumn)',
            lblPriceAndMarket: '@(Lang.PriceAndMarketMovement)',
            liveStartTime: @(Constants.LIVE_START_MINUTE),
            deadballStartTime: @(Constants.DEAD_BALL_START_MINUTE),
            liveStopTime: @(Constants.LIVE_STOP_MINUTE),
            deadballStopTime: @(Constants.DEAD_BALL_STOP_MINUTE),
            chooseALeague: '@(Lang.ChooseALeague)',
            chooseAMatch: '@(Lang.ChooseAMatch)',
            chooseABettype: '@(Lang.ChooseABettype)',
            chooseABettingOdd: '@(Lang.ChooseABettingOdd)',
            imageFolderUrl: '@(Url.Content("~/Content/Images/"))',
            redCardImage: '@(Url.Content("~/Content/Images/Red_card.png"))',
            ballImage: '@(Url.Content("~/Content/Images/Soccer_ball.png"))',
            yellowCard: '@(Url.Content("~/Content/Images/Yellow_card.png"))'
        };
        
        var LANGUAGE = 
        {
            live: '@(Lang.Live)',
            nonlive: '@(Lang.NonLive)',
            selectLeague: '@(string.Format(Lang.SelectA, Lang.League))',
            selectMatch: '@(string.Format(Lang.SelectA, Lang.Match))',
            selectBettingOdds: '@(string.Format(Lang.SelectA, Lang.BettingOdds))',
            home: '@(Lang.Home)',
            away: '@(Lang.Away)',
            draw: '@(Lang.Draw)',
            over: '@(Lang.Over)',
            under: '@(Lang.Under)',
            handicap: '@(Lang.Handicap)',
            overUnder: '@Lang.OverUnder',
            chartUnavai: '@Lang.ChartUnavailable'
        };
    </script>
    @RenderSection("Scripts", false)
    @RenderSection("Foot", false)
    
</body>
</html>

