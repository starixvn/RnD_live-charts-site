@using Fanex.LiveCharts.ViewModel.ScorePrediction;
@model ScorePredictionResultViewModel
@{
    ViewBag.Title = string.Format("{0} {1} {2} - {3}",
        Model.HomeName,
        Lang.VsLabel,
        Model.AwayName,
        Lang.TotalPredictionResult
        );
    Layout = "~/Views/Shared/_Layout.cshtml";
    var panelClass = Model.IsAdminSite ? "admin-prediction-result-panel" : "prediction-result-panel";
    var isStopPredictionStyle = Model.IsStopScorePrediction ? "dislay:none;" : string.Empty;
}
@section Styles
{
    <link rel="stylesheet" href="~/Content/MovementCharts/ScorePredictionResult.less"
        type="text/css" />
}
<div class="@(panelClass)">
    <div class="result-panel">
        <div class="result-information">
            <span class="result-label">@Lang.CorrectScore</span>
            <div class="result-button" style="@(isStopPredictionStyle)">
                <div class="refresh-button">
                    <div id="refreshCountDownCorrectScoreResult" class="refresh-button-main">
                    </div>
                </div>
            </div>
        </div>
        <div class="prediction-result" id="correctScoreResultContainer">
        </div>
    </div>
    <div class="result-panel">
        <div class="result-information">
            <span class="result-label">@Lang.Handicap</span>
            <div class="result-button" style="@(isStopPredictionStyle)">
                <div class="refresh-button">
                    <div id="refreshCountDownHandicapResult" class="refresh-button-main">
                    </div>
                </div>
            </div>
        </div>
        <div class="prediction-result" id="handicapResultContainer">
        </div>
    </div>
    <div class="result-panel">
        <div class="result-information">
            <span class="result-label">@Lang._1x2</span>
            <div class="result-button" style="@(isStopPredictionStyle)">
                <div class="refresh-button ">
                    <div id="refreshCountDownOneXTwoResult" class="refresh-button-main">
                    </div>
                </div>
            </div>
        </div>
        <div class="prediction-result" id="oneXTwoResultContainer">
        </div>
    </div>
    <div class="result-panel">
        <div class="result-information">
            <span class="result-label">@Lang.OddEven</span>
            <div class="result-button" style="@(isStopPredictionStyle)">
                <div class="refresh-button">
                    <div id="refreshCountDownOddEvenResult" class="refresh-button-main">
                    </div>
                </div>
            </div>
        </div>
        <div class="prediction-result" id="oddEvenResultContainer">
        </div>
    </div>
</div>
<script type="text/javascript">
    var scorePredictionViewModel = {
        matchId: @(Model.MatchId),
        homeName: '@(Model.HomeName)',
        awayName: '@(Model.AwayName)',
        isStopScorePrediction: @(Model.IsStopScorePrediction ? "true" : "false")
    };
    var LANGUAGE = 
        {
            draw: '@(Lang.Draw)',
            handicap: '@(Lang.Handicap)',
            oddEven: '@(Lang.OddEven)',
            correctScore: '@(Lang.CorrectScore)'
        };
</script>
@if (Model.IsAdminSite)
{
    <script type="text/javascript">
        var isAdminSite = true;
    </script>
}
@section Scripts
{
    @Scripts.Render("~/bundles/scorepredictionresult")
}
