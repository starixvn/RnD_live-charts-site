
<div class="score-prediction">
    <div class="prediction-input">
        <fieldset>
            <legend>
                @Lang.YourPrediction
            </legend>
            <div class="home-prediction">
                <div class="home-predict-value">
                    <input type="text" id="homePredictionValue" class="span3" />
                </div>
                <div class="home-name">
                    @Model.HomeName
                </div>
            </div>
            <div class="vs-label">
                @Lang.VsLabel
            </div>
            <div class="away-prediction">
                <div class="away-predict-value">
                    <input type="text" id="awayPredictionValue" class="span3" />
                </div>
                <div class="away-name">
                    @Model.AwayName
                </div>
            </div>
            <div class="prediction-submit">
                <input type="submit" id="submitPreditionValue" value="@Lang.Submit" />
            </div>
        </fieldset>
    </div>
    <div id="resultContainer" style="display: none;">
        <fieldset>
            <legend>
                @Lang.TotalPredictionResult
            </legend>
            <div class="result-information">
                <span class="result-label"><span class="home-name">@Model.HomeName</span> <span class="vs-name">@Lang.VsLabel</span>
                    <span class="away-name">@Model.AwayName</span> </span>
                <div class="result-button">
                    <div class="full-result">
                        <span class="full-result-link btn-link" id="fullResultLink"></span>
                    </div>
                    <div class="refresh-button">
                        <div id="resultRefreshCountDown">
                        </div>
                    </div>
                </div>
            </div>
            <div class="prediction-small-result" id="smallResultContainer">
            </div>
        </fieldset>
    </div>
</div>
