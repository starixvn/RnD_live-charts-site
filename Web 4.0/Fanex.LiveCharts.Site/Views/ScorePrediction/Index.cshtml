@using Fanex.LiveCharts.ViewModel.ScorePrediction
@using Fanex.LiveCharts.Core

@model ScorePredictionViewModel

@{
    var dislayNone = Model.IsStopScorePrediction ? "display:none;" : string.Empty;
    var resultConatinerStopPredictionClass = Model.IsStopScorePrediction ? "stop-prediction" : string.Empty;
}

@section Styles
{
    <link rel="stylesheet" href="~/Content/MovementCharts/ScorePrediction.less" type="text/css" />
}
<span class="collapse-expand-icon expand"></span>
<div class="score-prediction">
    <div class="chart-title">
    @Lang.ScorePrediction
</div>
    <div id="predictionContainer" class="prediction-input" style="@(dislayNone)">
        <div class="prediction-title">
            @Lang.YourPrediction
        </div>
        <div class="prediction-input-content">
            <div class="home-prediction">
                <div class="home-name">
                    @Model.Match.HomeName
                </div>
                <div class="home-predict-value">
                    <input type="text" id="homePredictionValue" />
                </div>
            </div>
            <div class="vs-label">
                @Lang.VsLabel
            </div>
            <div class="away-prediction">
                <div class="away-predict-value">
                    <input type="text" id="awayPredictionValue" />
                </div>
                <div class="away-name">
                    @Model.Match.AwayName
                </div>
            </div>
            <div class="prediction-submit">
                <input type="submit" id="submitPreditionValue" value="@Lang.Submit" class="btn" title="@Lang.SubmitAndViewResult" />
            </div>
        </div>
    </div>
    <div id="resultContainer" style="display: none;">
        <div class="prediction-title">
            @Lang.TotalPredictionResult
        </div>
        <div class="result-information">
            @*       <span class="result-label"><span class="home-name">@Model.HomeName</span> 
            <span class="vs-name">@Lang.VsLabel</span>
                <span class="away-name">@Model.AwayName</span> </span>*@
            <div class="result-button">
                <div class="full-result">
                    <span class="full-result-link btn-link" id="fullResultLink" title="@Lang.ViewAllScorePredictionResults">
                    </span>
                </div>
                <div class="refresh-button" style="@(dislayNone)">
                    <div id="resultRefreshCountDown">
                    </div>
                </div>
            </div>
        </div>
        <div class="prediction-small-result @(resultConatinerStopPredictionClass)" id="smallResultContainer">
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
        var SCORE_PREDICTION =
        {
            matchId: @(Model.Match.Id),
            isStopScorePrediction: @(Model.IsStopScorePrediction ? "true" : "false"),
            homeNameEncoded: '@(HttpUtility.UrlEncode(Model.Match.HomeName))',
            awayNameEncoded: '@(HttpUtility.UrlEncode(Model.Match.AwayName))',
            memberId: @(Model.MemberId)
        };
    </script>
    @Scripts.Render("~/bundles/scorepredictionjs")
}
