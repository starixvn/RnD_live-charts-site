@using Fanex.LiveCharts.Chat.ViewModels
@using Fanex.LiveCharts.Chat.Models
@model KickedOutViewModel
@{
    Layout = "~/Views/Shared/_AnnouncementLayout.cshtml";
    switch(Model.ChatUserStatus)
    {
        case ChatUserStatus.KickedOut:
            ViewBag.Title = Lang.YouHaveBeenKicked;
            break;
        case ChatUserStatus.Banned:
            ViewBag.Title = Lang.YouHaveBeenBanned;
            break;
        default:
            ViewBag.Title = Lang.SorrryChatUnavailable;
            break;
    }
}


@section Scripts
{
    <script type="text/javascript">
        var KICK_OUT_DEFUALT = 
        {
            getInformationForReEnterUrl: '@(Url.Action("GetInformationForReEnterPage", "Chat"))',
            chatPage: '@(Url.Action("Index", "Chat"))?matchId=@(Model.MatchId)'
        };
    </script>
    @Scripts.Render("~/bundles/kickoutpagejs")
}