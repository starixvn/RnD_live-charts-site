@using Fanex.LiveCharts.Chat.ViewModels
@using Fanex.LiveCharts.Chat.Models
@model ChatViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var maxMessageLength = 1000;
    var termArray = Model.AnnoucementMessage.SettingValue.Split(new string[] { "{br}" }, StringSplitOptions.None);
}
@section Styles
{
    <link rel="stylesheet" href="~/Content/MovementCharts/Chat.less?v=1" type="text/css" />
}
<div class="chat-room-container">
    <div class="chat-room-title">
        @Lang.ChatRoom
        <div class="in-out-container" style="display: none;" id="btnLeftRoom">
            <input type="submit" value="@(Lang.Out) " class="btn left-room" />
            <span class="icon-left"></span>
        </div>
    </div>
    <div class="room-container" id="roomContainer">
        <div class="main-room" id="chatConversation">
            <div id="showMessageHistory" class="show-message-history" style="display: none;">@Lang.ShowHistoryMessages</div>
            <ul id="mainChatRoom">
            </ul>
        </div>
        <div class="footer-room">
            <div class="members-info-container">
                <span class="member-text">@(Lang.Members):</span> <span class="member-online btn-link"
                    id="memberOnline">0</span>
            </div>
            <div class="timer-container">
                <span id="matchCompletedMessage" class="match-completed-message" style="display:none;">
                    @Html.Raw(string.Format(Lang.TheRoomWillBeClosed, "<span id='minuteToCompletedRoom'>10</span>"))
                </span>
                <span class="timer-text">@(Lang.GMTPlus8):</span> <span class="gmt-8-timer" id="gmt8Timer">
                </span>
            </div>
        </div>
    </div>
    <div class="room-input"  id="roomInput">
        <div class="text-input">
            <div class="multiline-icon-container">
                <span class="multiline-icon" id="btnMultiline" title="@Lang.MultilineOff" data-multiline-on="@Lang.MultilineOn" data-multiline-off="@Lang.MultilineOff" data-multiline-status="off">
                </span>
            </div>
            <textarea id="messageInput" placeholder="@Lang.Text" maxlength="1000"></textarea>
            <div class="emoticon-container">
                <span class="emoticon-icon" id="btnEmoticon" title="@Lang.Emoticon"></span>
            </div>
        </div>
        <div class="text-submit">
            <input type="submit"  id="submitMessage" class="btn btn-send" value="@Lang.Send" />
        </div>
    </div>
</div>
<!-- Modal -->
@if(string.IsNullOrEmpty(Model.ChatUser.ChatName) || Model.ChatUser.IsResetChatName)
{
    var isReset = Model.ChatUser.IsResetChatName;
    <div id="popupCreateOrEditChatName" class="modal hide fade" tabindex="-1" role="dialog"
        aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-header">
            <h3>@(isReset ? Lang.UpdateChatName : Lang.CreateChatName)</h3>
        </div>
        <div class="modal-body">
            <form class="bs-docs-example form-horizontal">
            <div class="control-group">
                @Html.Raw(Lang.ChatNameWarning)
            </div>
            <div class="control-group">
                <label class="control-label" for="txtChatName">@Lang.ChatName:</label>
                <div class="controls">
                    <input type="text" id="txtChatName" placeholder="@Lang.ChatName" value="@(isReset ? Model.ChatUser.ChatName : string.Empty)" />
                </div>
            </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn" id="btnCreateOrUpdateChatName">@(isReset ? Lang.Update : Lang.Create)</button>
        </div>
    </div>
}
@if (!Model.AnnoucementMessage.Disabled && !Model.ChatUser.AgreedTerms)
{ 
    <div id="popupTermsCondition" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel"
        aria-hidden="true">
        <div class="modal-header">
            <h3>@Lang.TermsCondition</h3>
        </div>
        <div class="modal-body">
            <form class="bs-docs-example form-horizontal">
            <div class="control-group" id="termConditionMessage">
                @Html.Raw(Lang.TermsConditionMessage)
            </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn" id="btnAgreeTerms">@Lang.Agree</button>
        </div>
    </div>
}
<div id="popupChatUserList" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel"
    aria-hidden="true">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;</button>
        <h3>@Lang.UserList</h3>
    </div>
    <div class="modal-body">
        <form class="bs-docs-example form-horizontal">
        <div id="userListContainer" class="user-list-container">
        </div>
        </form>
    </div>
</div>
<div id="popupWaitingJoinRoom" class="modal hide fade" tabindex="-1" role="dialog"
    aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-header">
        <h3>@Lang.JoinChatRoom</h3>
    </div>
    <div class="modal-body">
        <form class="bs-docs-example form-horizontal">
        <div class="control-group">
            <span id="waitingMessage">@Model.ChatUser.ChatName</span>, @Lang.WantToJoinRoom
        </div>
        </form>
    </div>
    <div class="modal-footer">
        <button class="btn" id="btnJoinRoom">@Lang.Join</button>
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/Libs/jquery.signalR-1.2.1.min.js"></script>
    <!--Reference the autogenerated SignalR hub script. -->
    <script src="~/signalr/hubs"></script>
    <script type="text/javascript">
        var CURRENT_CHAT_ROOM = 
        {
            matchId: @(Model.ChatRoom.MatchId),
            chatRoomId: @(Model.ChatRoom.ChatRoomId),
            chatRoomName: '@(Model.ChatRoom.ChatRoomName)',
            muted: @(Model.ChatRoom.Muted ? "true" : "false"),
            continueMuteInMinutes: @(Model.ChatRoom.ContinueMuteInMinutes),
            welcomeMessage: '@Html.Raw(Model.ChatRoom.WelcomeMessage)',
            termConditionDisabled: @(Model.AnnoucementMessage.Disabled ? "true" : "false")
        }

        var CURRENT_CHAT_USER_IN_ROOM = 
            {
                chatUserInRoomId: @(Model.ChatUserInRoom.ChatUserInRoomId),
                kickedOut: @(Model.ChatUserInRoom.KickedOut ? "true" : "false"),
                muted: @(Model.ChatUserInRoom.Muted ? "true" : "false"),
                continueMuteInMinutes: @(Model.ChatUserInRoom.ContinueMuteInMinutes),
            };

        var CURRENT_CHAT_USER = 
        {
            memberId: @(Model.ChatUser.MemberId),
            chatUserId: @(Model.ChatUser.ChatUserId),
            chatName: '@(Model.ChatUser.ChatName)',
            isBanned: '@(Model.ChatUser.IsBanned)',
            agreedTerms: @(Model.ChatUser.AgreedTerms ? "true" : "false"),
            isResetChatName: @(Model.ChatUser.IsResetChatName ? "true" : "false")
        }

        var CURRENT_TIME_FORMAT = 
        { 
            timeZone:'+08:00',
            format: 'HH:mm',
            timeLine: 'MMMM Do YYYY'
        }

        var DEFAULT_OBJECT = 
        {
            emoticonsFolder: '@Url.Content("~/Scripts/Libs/Emoticon/Images")',
            notificationSound: '@Url.Content("~/Content/Sounds/chat")',
            disconnectPage: '@Url.Action("YouAreDisconnect", "Chat")',
            kickedOutPage: '@(Url.Action("KickedOut", "Chat"))?matchId=@(ViewBag.MatchId)&chatUserStatus=@((int)ChatUserStatus.KickedOut)',
            bannedPage: '@(Url.Action("KickedOut", "Chat"))?matchId=@(ViewBag.MatchId)&chatUserStatus=@((int)ChatUserStatus.Banned)',
            disabledRoomPage: '@(Url.Action("KickedOut", "Chat"))?matchId=@(ViewBag.MatchId)&chatUserStatus=@((int)ChatUserStatus.DisableChatRoom)',
            welcomeMessage: '@Html.Raw(Model.WelcomeMessage.SettingValue)',
            disabledWelcomeMessage: @(Model.WelcomeMessage.Disabled ? "true" : "false"),
            getHistoryMessageUrl: '@Url.Action("GetChatMessageByTime", "Chat")',
            updateAgreeTerms: '@(Url.Action("UpdateAgreeTerms","Chat"))',
            checkMatchCompleted: '@(Url.Action("IsMatchCompleted","Charts"))',
            getCurrentRoom: '@(Url.Action("GetCurrentRoom","Chat"))',
            getBanWordsUrl: '@(Url.Action("GetBannedWords","Chat"))',
            chatCompletedPage: '@(Url.Action("ChatRoomCompleted","Chat"))',
            updateChatNameUrl: '@(Url.Action("UpdateChatName","Chat"))',
            maxMessageLength: @(maxMessageLength)
        }

        var LANGUAGE = 
        {
            chatNameCannotEmpty: '@Lang.ChatNameCannotEmpty',
            messageCannotEmpty: '@Lang.MessageCannotEmpty',
            youAreDisconnect: '@Lang.YouAreDisconnect',
            hasLeft: '@Lang.HasLeft',
            joinedRoom: '@Lang.JoinedRoom',
            maxLengthChatName: '@Lang.MaxLengthChatNameMessage',
            maxLengthMessage: '@(string.Format(Lang.MessageMaxLengthMessage, maxMessageLength))',
            sorryRoomNotAvailableForSendingMessage: '@Html.Raw(Lang.SorryRoomNotAvailableForSendingMessage)',
            youHaveBeenMuted: '@(Lang.YouHaveBeenMuted)',
            youHaveBeenMutedIn: '@(Lang.YouHaveBeenMutedIn)',
            thisRoomHasBeenMuted: '@(Lang.ThisRoomHasBeenMuted)',
            thisRoomHasBeenMutedIn: '@(Lang.ThisRoomHasBeenMutedIn)'
        }

    </script>
    @Scripts.Render("~/bundles/chatroomjs")
}
