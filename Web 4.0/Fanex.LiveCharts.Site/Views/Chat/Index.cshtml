<div class="chat-room-container">
    <div class="chat-room-title">
        @Lang.ChatRoom
    </div>
    <div class="room-container">
        <div class="main-room">
            <ul id="mainChatRoom">
            </ul>
        </div>
        <div class="footer-room">
            <span class="member-online" id="memberOnline">0</span>
        </div>
    </div>
    <div class="format-tools">
    </div>
    <div class="room-input">
        <div class="text-input">
            <textarea rows="1"  id="messageInput">
            </textarea>
        </div>
        <div class="text-submit">
            <input type="submit"  id="submitMessage" value="@Lang.Send" />
        </div>
    </div>
</div>
@section Scripts
{
    <script src="~/Scripts/Libs/jquery.signalR-1.2.1.min.js"></script>
    <!--Reference the autogenerated SignalR hub script. -->
    <script src="~/signalr/hubs"></script>

    <script type="text/javascript">
        var CURRENT_CHAT_ROOM = 
        {
            matchId: @(Model.ChatRoom.MatchId),
            chatRoomId: @(Model.ChatRoom.ChatRoomId),
            chatRoomName: '@(Model.ChatRoom.ChatRoomName)',
            welcomeMessage: '@(Model.ChatRoom.WelcomeMessage)'
        }

        var CURRENT_CHAT_USER_IN_ROOM = 
            {
                chatUserInRoomId: @(Model.ChatUserInRoom.ChatUserInRoomId),
                kickedOut: @(Model.ChatUserInRoom.KickedOut ? "true" : "false")
            };

        var CURRENT_CHAT_USER = 
        {
            memberId: @(Model.ChatUser.MemberId),
            chatUserId: @(Model.ChatUser.ChatUserId),
            chatName: '@(Model.ChatUser.ChatName)',
            isBanned: '@(Model.ChatUser.IsBanned)'
        }
    </script>
    
    @Scripts.Render("~/bundles/chatroomjs")
}
