@model Fanex.LiveCharts.Chat.ViewModels.ChatViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles
{
    <link rel="stylesheet" href="~/Content/MovementCharts/Chat.less" type="text/css" />
}
<div class="chat-room-container">
    <div class="chat-room-title">
        @Lang.ChatRoom
        <div class="in-out-container" style="display:none;" id="btnLeftRoom">
            <input type="submit" value="@(Lang.Out) " class="btn left-room" />
            <span class="icon-left"></span>
        </div>
    </div>
    <div class="room-container">
        <div class="main-room" id="chatConversation">
            <div id="showMessageHistory" class="show-message-history" style="display: none;">@Lang.ShowHistoryMessages</div>
            <ul id="mainChatRoom">
            </ul>
        </div>
        <div class="footer-room">
            <div class="members-info-container">
                <span class="member-text">@(Lang.Members):</span> <span class="member-online btn-link" id="memberOnline">
                    0</span>
            </div>
            <div class="timer-container">
                <span class="timer-text">@(Lang.GMTPlus8):</span> <span class="gmt-8-timer" id="gmt8Timer">
                </span>
            </div>
        </div>
    </div>
    <div class="room-input">
        <div class="text-input">
            <div class="multiline-icon-container">
                <span class="multiline-icon" id="btnMultiline" title="@Lang.MultilineOff" data-multiline-on="@Lang.MultilineOn" data-multiline-off="@Lang.MultilineOff" data-multiline-status="off"></span>
            </div>
            <textarea id="messageInput" placeholder="@Lang.Text" maxlength="1000"></textarea>
            <div class="emoticon-container">
                <span class="emoticon-icon" id="btnEmoticon">
                </span>
            </div>
        </div>
        <div class="text-submit">
            <input type="submit"  id="submitMessage" class="btn btn-send" value="@Lang.Send" />
        </div>
    </div>
</div>
<!-- Modal -->
<div id="popupCreateChatName" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel"
    aria-hidden="true">
    <div class="modal-header">
        <h3>@Lang.CreateChatName</h3>
    </div>
    <div class="modal-body">
        <form class="bs-docs-example form-horizontal">
        <div class="control-group">
            <label class="control-label" for="txtChatName">@Lang.ChatName:</label>
            <div class="controls">
                <input type="text" id="txtChatName" placeholder="@Lang.ChatName"/>
            </div>
        </div>
        </form>
    </div>
    <div class="modal-footer">
        <button class="btn" id="btnCreateChatName">@Lang.Create</button>
    </div>
</div>
@if(!Model.AnnoucementMessage.Disabled)
{ 
    <div id="popupJoinRoom" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel"
        aria-hidden="true">
        <div class="modal-header">
            <h3>@Lang.JoinChatRoom</h3>
        </div>
        <div class="modal-body">
            <form class="bs-docs-example form-horizontal">
            <div class="control-group">
                @Model.AnnoucementMessage.SettingValue
            </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn" id="btnJoinRopm">@Lang.Join</button>
        </div>
    </div>
}


<div id="popupChatUserList" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel"
    aria-hidden="true">
    <div class="modal-header">
         <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h3>@Lang.UserList</h3>
    </div>
    <div class="modal-body">
        <form class="bs-docs-example form-horizontal">
            <div id="userListContainer" class="user-list-container">
            
            </div>
        </form>
    </div>
</div>


@section Scripts
{
    <script src="~/Scripts/Libs/jquery.signalR-1.2.1.min.js"></script>
    <!--Reference the autogenerated SignalR hub script. -->
    <script src="~/signalr/hubs"></script>
    <script type="text/javascript">
        var CURRENT_CHAT_ROOM = 
        {
            matchId: @(Model.ChatRoom.MatchId),
            chatRoomId: @(Model.ChatRoom.ChatRoomId),
            chatRoomName: '@(Model.ChatRoom.ChatRoomName)',
            welcomeMessage: '@(Model.ChatRoom.WelcomeMessage)'
        }

        var CURRENT_CHAT_USER_IN_ROOM = 
            {
                chatUserInRoomId: @(Model.ChatUserInRoom.ChatUserInRoomId),
                kickedOut: @(Model.ChatUserInRoom.KickedOut ? "true" : "false")
            };

        var CURRENT_CHAT_USER = 
        {
            memberId: @(Model.ChatUser.MemberId),
            chatUserId: @(Model.ChatUser.ChatUserId),
            chatName: '@(Model.ChatUser.ChatName)',
            isBanned: '@(Model.ChatUser.IsBanned)'
        }

        var CURRENT_TIME_FORMAT = 
        { 
            timeZone:'+08:00',
            format: 'HH:mm'
        }

        var DEFAULT_OBJECT = 
        {
            emoticonsFolder: '@Url.Content("~/Scripts/Libs/Emoticon/Images")',
            notificationSound: '@Url.Content("~/Content/Sounds/chat")',
            disconnectPage: '@Url.Action("YouAreDisconnect", "Chat")',
            kickedOutPage: '@Url.Action("KickedOut", "Chat")',
            welcomeMessage: '@(Model.WelcomeMessage.SettingValue)',
            disabledWelcomeMessage: @(Model.WelcomeMessage.Disabled ? "true" : "false")
        }

        var LANGUAGE = 
        {
            chatNameCannotEmpty: '@Lang.ChatNameCannotEmpty',
            messageCannotEmpty: '@Lang.MessageCannotEmpty',
            youAreDisconnect: '@Lang.YouAreDisconnect',
            hasLeft: '@Lang.HasLeft',
            joinedRoom: '@Lang.JoinedRoom',
            maxLengthChatName: '@Lang.MaxLengthChatNameMessage'
        }

    </script>
    
    @Scripts.Render("~/bundles/chatroomjs")
}
