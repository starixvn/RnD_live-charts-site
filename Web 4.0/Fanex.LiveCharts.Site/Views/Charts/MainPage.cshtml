@using Fanex.LiveCharts.ViewModel
@model MainPageViewModel
@{
    ViewBag.Title = "Main Page";
}
@section Styles
{
    <link rel="stylesheet" href="~/Content/MovementCharts/MainPage.less" type="text/css" />
}
<div class="main-page">
    <div class="chart-page">
         <iframe id="frmChartPage" width="100%" height="100%" src="~/Charts/ChartContent?matchId=@(Model.MatchId.ToString())" frameborder="0"></iframe>
    </div>
    <div class="score-prediction-page">
        <iframe id="frmScorePredictionPage" width="100%" height="100%" src="~/ScorePrediction/Index?matchId=@(Model.MatchId.ToString())" frameborder="0"></iframe>
    </div>
    <div class="chat-page" style="display: none;">
        <iframe id="frmChatPage" width="100%" height="100%" src="" frameborder="0"></iframe>
    </div>
</div>
