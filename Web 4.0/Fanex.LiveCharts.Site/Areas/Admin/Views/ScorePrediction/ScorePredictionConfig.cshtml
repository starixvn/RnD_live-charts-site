@using Fanex.LiveCharts.ViewModel.ScorePredictionViewModel;
@using Fanex.LiveCharts.Models.ScorePrediction;
@model ScorePredictionResultViewModel
@{
    ViewBag.Title = "Score Prediction Config Page";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var scorePredictionOptions = ViewBag.ScorePredictionOptions as ScorePredictionTotal;
}


<div>
    @Model.HomeName - @Model.AwayName
</div>

<iframe id="frmChartContent" width="99%" height="670px" src="~/ScorePrediction/Index?matchId=@(Model.MatchId)&homeName=@(HttpUtility.UrlEncode(Model.HomeName))&awayName=@(HttpUtility.UrlEncode(Model.AwayName))&isAdminSite=true" frameborder="0">
    </iframe>
<div class="dummy-prediction-container">
    <div class="team-name">
        <div>@Model.HomeName</div>
        <div><input type="text" id="homePredictionValue" /> </div>
    </div>
     <div class="team-name">
        <div>@Model.AwayName</div>
        <div><input type="text" id="awayPredictionValue" /> </div>
    </div>
     <div class="prediction-value">
        <div>@AdminSiteLang.VotingNumber</div>
        <div><input type="text" id="predictionValue" /> </div>
    </div>
</div>
<input type="button" id="updateDummy" value="update" />
<input type="hidden" id="updateDummyUrl" value='@(Url.Action("UpdateDummyPrediction", "ScorePrediction"))' />
                                                
@section Foot {
    @Scripts.Render("~/areas/admin/scorepredictionconfigjs")
}