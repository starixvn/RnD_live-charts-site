@{
    ViewBag.Title = "Score Prediction Setting";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="setting-container">
    <form method="post" action="@(Url.Content("~"))">
    <div class="form dummy-prediction-container">
        <div class="form-row">
            <div class="lbl-field">@AdminSiteLang.AvailableTime</div>
            <div class="edit-field">
                <input type="text" id="availableTime" value="0" />
                <span class="minute-available">@AdminSiteLang.Minutes</span>
                <input type="button" id="updateDummy" type="submit" value="@Lang.Submit" />
            </div>
        </div>
    </div>
    </form>
</div>
