@using Fanex.NAP.Framework.Command
@model Fanex.LiveCharts.Models.SettingItem
@{
    ViewBag.Title = AdminSiteLang.ScorePredictionSetting;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var updateResult = ViewBag.updateResult as ICommandResult;
    var firstTime = updateResult == null;
    var success = updateResult != null && updateResult.IsSuccessful;
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span></h1>
}
<div class="setting-container">
    <form method="post" id="availableForm" action="@(Url.Action("ScorePrediction", "Setting", new { Area = "Admin" }))">
    <div class="form dummy-prediction-container ">
        <div id="messageContainer" class="form-row summary" style="@(firstTime ? "display:none;" : string.Empty)">
                <div id="messageList" class="@(success ? "validation-summary-valid" : "validation-summary-errors")" data-valmsg-summary="true">
                    <ul>
                        @if (success)
                        {
                            <li>@AdminSiteLang.AvailableTimeUpdateSuccess</li>
                       
                        }
                        else
                        {
                            <li>@AdminSiteLang.AvailableRequired</li>
                      
                        }
                    </ul>
                </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">@AdminSiteLang.AvailableTime:</div>
            <div class="edit-field">
                <input type="hidden" name="SettingId" id="SettingId" value="@Model.SettingId" />
                <input type="hidden" name="SettingName" id="SettingName" value="@Model.SettingName" />
                <input type="text" class="setting-value @(success || firstTime ? string.Empty : "input-validation-error")" name="SettingValue" id="SettingValue" value="@Model.SettingValue" maxlength="4" />
                <span class="minute-available">@AdminSiteLang.Minutes</span>
                <input id="updateDummy" type="submit" value="@Lang.Submit" />
            </div>
        </div>
    </div>
    </form>
</div>

@section Foot {
    <script type="text/javascript">
        var SCORE_PREDICTION_SETTING = 
        {
            defaultSucces: @(success ? "true" : "false"),
            maxInputErrorMessage: "@(AdminSiteLang.InputNumberMaxError4)"
        };
    </script>

     @Scripts.Render("~/areas/admin/scorepredictionconfigsettingjs")
}
