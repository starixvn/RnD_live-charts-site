@using Fanex.LiveCharts.Chat.ViewModels;
@using Fanex.LiveCharts.Core;
@model ChatMonitorViewModel
@{
    ViewBag.Title = AdminSiteLang.MonitorChatConversation;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var gridTitle = string.Format("{0} -vs- {1}, {2}(GMT+8): {3}",
        Model.Match.HomeName,
        Model.Match.AwayName,
        AdminSiteLang.KickOffTime,
        Model.Match.KickOffTimeGMT8);
}
@section Head {
    <link type="text/css" rel="Stylesheet" href="~/Areas/Admin/Content/Chat.min.css" />
}
@section Headline {
    <h1>
        <span class="title">@AdminSiteLang.MonitorChatConversation</span>
    </h1>
}
<section id="filter-bar">
    <div class="filter-form">
        <div class="lbl-field width-auto">
            <label>@AdminSiteLang.Member</label>
		</div>
        <div class="edit-field width-140">
            <select id="ddlMemberName" data-placeholder="@AdminSiteLang.Member"></select>
		</div>
        <div class="lbl-field width-auto">
            <label>@AdminSiteLang.ChatName</label>
		</div>
        <div class="edit-field width-140">
            <select id="ddlChatName"  data-placeholder="@AdminSiteLang.ChatName"></select>
		</div>
        <div class="lbl-field width-auto">
            <label>@AdminSiteLang.ChatMessage</label>
		</div>
        <div class="edit-field width-220">
			<input type="text" class="width-200" id="txtMessageSearch" />
		</div>
        <div class="submit btn-submit">
				<input type="submit" value="@ViewResources.Submit" id="btnSearchChatMessage" />
			</div>
    </div>
</section>
<div class="chart-monitor">
    <div id="messageGrid-grid-title" class="grid-title">
        <div class="grid-title-label" id="reporttile">@(gridTitle)</div>
        <div class="grid-toolbox">
            @if (!Model.IsMatchCompleted)
            {
                <label for="stopAutoRefresh" class="stop-auto-refresh">
                    @AdminSiteLang.StopAutoRefresh
                <input type="checkbox" id="stopAutoRefresh" />
                </label>
                <div class="refresh-button">
                    <div id="resultRefreshCountDown">
                    </div>
                </div>
            }
            <input type="button" id="btnExportmessageGrid" class="btnExcel" title="@AdminSiteLang.ExportExcel" /></div>
    </div>
    <div id="messageGrid" class="freegrid">
    </div>
</div>
<div class="chat-user-status-container">
    @*<div class="chat-user-status-title">
        @AdminSiteLang.ChatUserStatus</div>*@
    <div id="chatUserGrid" class="freegrid">
    </div>
</div>
@section Foot {
    <script type="text/javascript">
        var CHAT_MONITOR_DEFAULT = {
            matchId: @(Model.ChatRoom.MatchId),
            chatRoomId: @(Model.ChatRoom.ChatRoomId),
            chatRoomName: "@(Model.ChatRoom.ChatRoomName)",
            isRoomMuted: @(Model.ChatRoom.Muted ? "true" : "false"),
            getChatMessagesUrl: "@(Url.Action("GetChatMessages", "ChatAdmin"))",
            kickOutChatUserUrl: "@(Url.Action("KickOutChatUser", "ChatAdmin"))",
            banChatUser: "@(Url.Action("BanChatUser", "ChatAdmin"))",
            updateChatUserStatusUrl: "@(Url.Action("UpdateChatUserStatus", "ChatAdmin"))",
            updateChatMessageUrl: "@(Url.Action("UpdateChatMessage", "ChatAdmin"))",
            updateAllChatMessageByChatUserUrl: "@(Url.Action("UpdateAllChatMessageByChatUser", "ChatAdmin"))",
            recoverChatUserUrl: "@(Url.Action("RecoverChatUser", "ChatAdmin"))",
            recoverBannedChatUserUrl: "@(Url.Action("RecoverBannedChatUser", "ChatAdmin"))",
            exportExcelUrl: "@(Url.Action("ExportExcel", "ChatAdmin"))",
            updateMuteChatUserUrl: "@(Url.Action("UpdateMuteChatUser", "ChatAdmin"))",
            updateMuteChatRoomUrl: "@(Url.Action("UpdateMuteChatRoom", "ChatAdmin"))",
            updateUnMuteForExpiredMute: "@(Url.Action("UpdateUnMuteForExpiredMute", "ChatAdmin"))",
            gridTitle: "@(gridTitle)",
            memberChartSiteUrl: "@(AppSettings.MemberChartSiteUrl)"
        };

        var LANGUAGE = {
            timeGTM8: '@(AdminSiteLang.TimeGMT8)',
            username: '@(AdminSiteLang.Username)',
            chatName: '@(AdminSiteLang.ChatName)',
            chatMessage: '@(AdminSiteLang.ChatMessage)',
            recoverChatSuccess: '@(AdminSiteLang.RecoverChatSuccess)',
            updateSuccess: '@(AdminSiteLang.UpdateSuccessfully)',
            recoverChatUser: '@(AdminSiteLang.RecoverChatUser)',
            deleteMessageSuccess: '@(AdminSiteLang.DeleteMessageSuccess)',
            kickedOutChatUserSuccess: '@(AdminSiteLang.KickedOutChatUserSuccess)',
            banChatUserSuccess: '@(AdminSiteLang.BanChatUserSuccessMessage)',
            recoverMessageFromUser: '@(AdminSiteLang.RecoverMessageFromUser)',
            recoverThisMessage: '@(AdminSiteLang.RecoverThisMessage)',
            removeThisMessage: '@(AdminSiteLang.RemoveThisMessage)',
            banThisUser: '@(AdminSiteLang.BanThisUser)',
            muteThisUser: '@(AdminSiteLang.MuteThisUserInWholeMatchTime)',
            unmuteThisUser: '@(AdminSiteLang.UnMuteThisUser)',
            unBanThisUser: '@(AdminSiteLang.UnBanThisUser)',
            removeAllMessagesFromUser: '@(AdminSiteLang.RemoveAllMessagesFromUser)',
            kickOutThisUser: '@(AdminSiteLang.KickOutThisUser)',
            reAddThisUser: '@(AdminSiteLang.ReAddThisUser)',
            clickToMute: '@(AdminSiteLang.ClickToMute)',
            clickToUnMute: '@(AdminSiteLang.ClickToUnMute)',
            muteThisUser5Minutes: '@(string.Format(AdminSiteLang.MuteThisUserInMinutes, 5))',
            muteThisUser10Minutes: '@(string.Format(AdminSiteLang.MuteThisUserInMinutes, 10))',
            muteThisUser15Minutes: '@(string.Format(AdminSiteLang.MuteThisUserInMinutes, 15))',
            muteThisRoom5Minutes: '@(string.Format(AdminSiteLang.MuteThisRoomInMinutes, 5))',
            muteThisRoom10Minutes: '@(string.Format(AdminSiteLang.MuteThisRoomInMinutes, 10))',
            muteThisRoom15Minutes: '@(string.Format(AdminSiteLang.MuteThisRoomInMinutes, 15))',
            muteThisRoomInWholeMatchTime: '@(AdminSiteLang.MuteThisRoomInWholeTime)'
        };
    </script>
    @Scripts.Render("~/areas/admin/chatmonitorjs")
    
}
