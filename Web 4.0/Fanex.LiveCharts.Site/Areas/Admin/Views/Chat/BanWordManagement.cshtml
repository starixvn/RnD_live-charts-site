@{
    ViewBag.Title = AdminSiteLang.BannedWordManagement;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link type="text/css" rel="Stylesheet" href="~/Areas/Admin/Content/Chat.less" />
}
@section Headline {
    <h1>
        <span class="title">@AdminSiteLang.BannedWordManagement</span>
        <a class="lnk" href="javascript:void(0);" id="btnAddNewBanWord">+ @ViewResources.Add_New</a>
    </h1>
}
<section id="filter-bar">
    <div class="filter-form">
        <div class="lbl-field width-auto">
            <label>@AdminSiteLang.StartWith</label>
		</div>
        <div class="edit-field width-120">
           <select id="ddlStartWithGroups" class="width-100">
                <option value="">@AdminSiteLang.All</option>
                @for (int i = 65; i <= 90; i++)
                {
                    <option value="@((char)i)">@((char)i)</option>
                }
            </select>
		</div>
        <div class="lbl-field width-auto">
            <label>@AdminSiteLang.BanWord</label>
		</div>
        <div class="edit-field width-180">
           <input type="text" class="width-160" id="txtBanWord" maxlength="50" />
		</div>
        <div class="lbl-field width-auto">
            <label>@AdminSiteLang.Status</label>
		</div>
        <div class="edit-field width-160">
           <select id="ddlWordStatus" class="width-140">
                <option value="0">@AdminSiteLang.All</option>
                <option value="1">@AdminSiteLang.NotIncludeDeleted</option>
                <option value="2">@AdminSiteLang.JustOnlyDeleted</option>
           </select>
		</div>
        <div class="submit btn-submit">
			<input type="submit" value="@ViewResources.Submit" id="btnSearchBanWord" />
		</div>
    </div>
</section>

<div class="chat-member-search-result" style="display:none;">
    <div id="banWordGrid" class="freegrid">
    </div>
</div>

<div id="addNewBanWordPopUp" class="ban-word-popup" style="display:none;">
    <div class="filter-form">
        <div class="lbl-field width-auto">
            <label>@(AdminSiteLang.BanWord)(s)</label>
		</div>
        <div class="edit-field ban-word-texts-container">
           <textarea id="banWordTextsAddNew" class="ban-word-texts"></textarea>
		</div>
        <div class="submit btn-submit">
			<input type="submit" value="@ViewResources.Submit" id="btnSubmitAddNew" />
		</div>
    </div>
</div>

<div id="editBanWordPopUp"  class="ban-word-popup" style="display:none;">
    <div class="filter-form">
        <div class="lbl-field width-auto">
            <label>@(AdminSiteLang.BanWord)</label>
		</div>
        <div class="edit-field width-220">
           <input type="text" class="width-200" id="banWordTextsUpdate" />
		</div>
        <input type="hidden" id="banWordIdForUpdate" />
        <div class="submit btn-submit">
			<input type="submit" value="@ViewResources.Submit" id="btnSubmitEdit" />
		</div>
    </div>
</div>

@section Foot {
    <script type="text/javascript">
        var BAN_WORD_MANAGEMENT =
        {
            getBanWordsUrl: "@(Url.Action("GetBanWords", "ChatAdmin"))",
            insertBanWordsUrl: "@(Url.Action("InsertBanWords", "ChatAdmin"))",
            updateBanWordTextUrl: "@(Url.Action("UpdateBanWordText", "ChatAdmin"))",
            updateBanWordStatusUrl: "@(Url.Action("UpdateBanWordStatus", "ChatAdmin"))"
        };

        var LANGUAGE = 
        {
            updateSuccess: '@AdminSiteLang.UpdateSuccessfully',
            recoverBannedWord: '@AdminSiteLang.RecoverBanWord',
            deleteBannedWord: '@AdminSiteLang.DeleteBanWord',
            updateBannedWord: '@AdminSiteLang.UpdateBanWord'
        };
    </script>
    @Scripts.Render("~/areas/admin/banwordmanagementjs")
}