<!DOCTYPE html>
<!--[if (IE 7)]><html lang="en" class="ie7 oldie"><![endif]-->
<!--[if (IE 8)]><html lang="en" class="ie8 oldie"><![endif]-->
<!--[if (IE 9)]><html lang="en" class="ie9"><![endif]-->
<!--[if (gt IE 9)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--[if lt IE 9]><script src="~/Areas/Admin/Scripts/html5shiv.js" type="text/javascript"></script><![endif]-->
    <link href="~/Content/themes/reset.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/jQueryUI/jquery-ui-1.10.3.custom.min.css" rel="stylesheet"
        type="text/css" />
    <link href="~/Content/themes/nap/style.less" rel="stylesheet" type="text/css" />
    @if (IsSectionDefined("Head"))
    {
        @RenderSection("Head")
    }
    else
    {
        <link href="~/Areas/Admin/Content/AdminSite.less" rel="stylesheet" type="text/css" />
    }
</head>
<body>
    <header>
		<div class="logo">
            @Html.ActionLink(AdminSiteLang.Title, "GetEnableCharts", "Match", new { Area = "Admin" }, new { })
        </div>
		<nav>
	        <ul class="menu">
                <li class="has-kids">
                    @Html.ActionLink(AdminSiteLang.EnableCharts, "GetEnableCharts", "Match", new { Area = "Admin" }, new { })
                </li>
                <li class="has-kids">
                    @Html.ActionLink(AdminSiteLang.SearchMatches, "Search", "Match", new { Area = "Admin" }, new { })
                </li>
                 <li class="has-kids">
                     <a href="javascript:void(0);">Chat User Management</a>
                      <ul>
                      <li>
                            @Html.ActionLink("Chat User Banned Management", "Index", "ChatUserBannedManagement", new { Area = "Admin" }, new { })
                        </li>
                        <li>
                            @Html.ActionLink("Member Ban By Default Management", "MemberBanByDefault", "ChatUserBannedManagement", new { Area = "Admin" }, new { })
                        </li>
                        </ul>
                </li>
                 <li class="has-kids">
                    <a href="javascript:void(0);">Settings</a>
                    <ul>
                        <li>
                            @Html.ActionLink("Score Prediction", "ScorePrediction", "Setting", new { Area = "Admin" }, new { })
                        </li>
                        <li>
                            @Html.ActionLink("Chat", "Chat", "Setting", new { Area = "Admin" }, new { })
                        </li>
                       
                    </ul>
                </li>
            </ul>
        </nav>
		<div class="auth">
            @ViewResources.Howdy, @HttpContext.Current.User.Identity.Name
            <span class="sep">|</span>
            @Html.ActionLink(ViewResources.Log_Out, "LogOut", "Login", new { Area = "UserLogin" }, new { })
        </div>
	</header>
    <section id="headline">
		@RenderSection("Headline", false)
	</section>
    <section id="body">
		<div class="content">
			@RenderBody()
            <div class="div-message-infomation">
                 <span id="messageNotification" class="error-message" data-success-message="@AdminSiteLang.AddEditEventSuccessfully">
                 </span>
            </div>
		</div>
	</section>
    @Html.Hidden("LiveChartRoot", Url.Content("~/Admin/"))
    @Html.Hidden("NapRoot", Url.Content("~/"))
    @Scripts.Render("~/bundles/adminsitejquery")
    @Scripts.Render("~/areas/admin/adminscripts")
    @RenderSection("Foot", false)
</body>
</html>
